# ══ 高德 ══

# 服务端专用，绝不能加 NEXT_PUBLIC_ 前缀
AMAP_WEB_SERVICE_KEY=

# 浏览器可见，靠高德控制台域名白名单保护。类型必须是「Web端(JS API)」
NEXT_PUBLIC_AMAP_JS_KEY=

# 安全密钥，仅服务端代理路由使用，不进浏览器
AMAP_JS_SECURITY_CODE=

# ══ DeepSeek（推荐层）══

# 服务端专用，绝不能加 NEXT_PUBLIC_ 前缀
DEEPSEEK_API_KEY=

# 模型 ID。**不要照抄，先跑 `npm run models` 看你的账号能用哪些。**
# 官方文档不同版本出现过 deepseek-chat / deepseek-coder / deepseek-v4-flash /
# deepseek-v4-pro 等不一致的名字，另有第三方称旧标识已移除——所以我们不猜。
# 留空时应用启动会直接报错并列出可用模型。
DEEPSEEK_MODEL=

# OpenAI 兼容端点
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 单次回包的 token 上限，默认 16384。
# 留意的两点：deepseek-flash 是**推理模型**，推理 token 与正文共用这个额度；
# 而 skill 的输出很重（每条带 fit 证据、itinerary 等）。额度太小会导致
# JSON 被截断、整次推荐失败，界面会提示「回包被 max_tokens 截断」。
# 这只是上限，用不到不额外计费，所以不必调小。
DEEPSEEK_MAX_TOKENS=16384

# ══ 路线规划 ══

# amap | mock  （没有高德 Key 时用 mock 也能跑通交互）
ROUTE_PROVIDER=mock

# ══ 推荐层数据源 ══
# mock  = 演示数据（真实厦门地名，仍走高德真实核实），不需要任何 Key
# skill = 调 DeepSeek，需要上面的 DEEPSEEK_*
RECOMMEND_PROVIDER=mock
